# Copie para `.env` e ajuste antes de rodar `docker compose up`.
# Nenhuma destas variáveis é necessária para rodar localmente sem Docker
# (sem elas o backend usa SQLite e modo desenvolvimento).

# --- Django ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
GOOGLE_OAUTH_CLIENT_ID=737343454700-4t7lpkk0ofccmf21bc4s9nnkj56rkels.apps.googleusercontent.com

# --- Postgres ---
POSTGRES_DB=tevejo
POSTGRES_USER=tevejo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
